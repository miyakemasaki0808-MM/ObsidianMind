<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Vigilith" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/indigo</item>
        <item name="android:statusBarColor">@color/indigo</item>
    </style>

    <style name="Theme.Vigilith.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/vigilith_slate</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Vigilith</item>
        <item name="android:navigationBarColor">@color/vigilith_slate</item>
        <item name="android:statusBarColor">@color/vigilith_slate</item>
    </style>
</resources>
