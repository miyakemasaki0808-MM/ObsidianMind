<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 13+ のテーマアイコン（monochrome）用シルエット。
  システムが単色でtintするため、色は塗り分けられない。よってレンズは
  「塗る」のではなく **穴で抜く**。

  1つのpathに、頭部と耳シャードを時計回り・レンズを反時計回りで書くことで、
  nonZero則によりレンズだけが穴になる（複数pathに分けると穴を開けられない）。
  レンズはカラー版より大きめ（r=7.5）にして、単色でも梟の目と分かるようにしている。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FF000000"
        android:fillType="nonZero"
        android:pathData="M54,32 L72,39 L77,56 L69,72 L54,78 L39,72 L31,56 L36,39 Z
                          M34,27 L51,35 L40,40 Z
                          M74,27 L68,40 L57,35 Z
                          M36.5,56 a7.5,7.5 0 1,0 15,0 a7.5,7.5 0 1,0 -15,0
                          M56.5,56 a7.5,7.5 0 1,0 15,0 a7.5,7.5 0 1,0 -15,0" />
</vector>
