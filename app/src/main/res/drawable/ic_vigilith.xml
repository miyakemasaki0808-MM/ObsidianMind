<?xml version="1.0" encoding="utf-8"?>
<!--
  Vigilith（黒曜の梟オートマトン）のマーク。
  design/character_vigilith.md §8「顔＝二つのレンズ＋耳シャード」の縮約。
  ハローはAdaptive Iconの背景レイヤー（ic_vigilith_background）へ分離している。

  座標系は Adaptive Icon の 108x108。造形はすべて中央66dpのセーフゾーン
  （中心 54,54 から半径33）に収め、円形マスクでも耳シャードが欠けないようにしている。

  ランチャーの最小48pxでも「二つのアクアの目」が判別できることを優先し、
  レンズを大きく取って頭部のファセットは輪郭＋稜線だけに留めた
  （面を描き込むと小サイズで黒い塊に潰れる）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 耳（羽角）＝黒曜石のシャード。梟性と鉱物性を同時に担う要素。 -->
    <path
        android:pathData="M40,40 L34,27 L51,35 Z"
        android:strokeColor="#4D3DFF"
        android:strokeWidth="0.9"
        android:strokeLineJoin="round">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="42.5" android:startY="27"
                android:endX="42.5" android:endY="40">
                <item android:offset="0" android:color="#FF33456E" />
                <item android:offset="1" android:color="#FF0A1428" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M68,40 L74,27 L57,35 Z"
        android:strokeColor="#4D3DFF"
        android:strokeWidth="0.9"
        android:strokeLineJoin="round">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="65.5" android:startY="27"
                android:endX="65.5" android:endY="40">
                <item android:offset="0" android:color="#FF33456E" />
                <item android:offset="1" android:color="#FF0A1428" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 頭部。低ポリにカットした黒曜石。 -->
    <path
        android:pathData="M54,32 L36,39 L31,56 L39,72 L54,78 L69,72 L77,56 L72,39 Z"
        android:strokeColor="#4D3DFF"
        android:strokeWidth="1.1"
        android:strokeLineJoin="round">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="40.2" android:startY="32"
                android:endX="63.2" android:endY="78">
                <item android:offset="0" android:color="#FF1A2A48" />
                <item android:offset="0.5" android:color="#FF0C1730" />
                <item android:offset="1" android:color="#FF050E1D" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 稜線（ファセットの示唆）。面を塗り分けず線だけで鉱物感を出す。 -->
    <path
        android:pathData="M54,32 L54,42"
        android:strokeColor="#4D3DFF" android:strokeWidth="0.7" android:strokeAlpha="0.55" />
    <path
        android:pathData="M36,39 L54,42 L72,39"
        android:strokeColor="#4D3DFF" android:strokeWidth="0.7" android:strokeAlpha="0.55" />
    <path
        android:pathData="M39,72 L54,78 L69,72"
        android:strokeColor="#4D3DFF" android:strokeWidth="0.7" android:strokeAlpha="0.55" />

    <!-- 左の読書レンズ。アパーチャ（虹彩絞り）を思わせる同心円。 -->
    <path
        android:pathData="M33,56 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0"
        android:fillColor="#FF03091A"
        android:strokeColor="#4D3DFF" android:strokeWidth="1.1" />
    <path
        android:pathData="M36,56 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0"
        android:strokeColor="#00C2FF" android:strokeWidth="2.2" />
    <path
        android:pathData="M39.6,56 a4.4,4.4 0 1,0 8.8,0 a4.4,4.4 0 1,0 -8.8,0"
        android:strokeColor="#00C2FF" android:strokeWidth="0.8" android:strokeAlpha="0.6" />
    <path android:pathData="M41.3,56 a2.7,2.7 0 1,0 5.4,0 a2.7,2.7 0 1,0 -5.4,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="44" android:centerY="56" android:gradientRadius="2.7">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="0.3" android:color="#FF8ADCFF" />
                <item android:offset="0.65" android:color="#FF00C2FF" />
                <item android:offset="1" android:color="#590079B8" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M40.85,53.8 a0.95,0.95 0 1,0 1.9,0 a0.95,0.95 0 1,0 -1.9,0"
        android:fillColor="#FFFFFFFF" />

    <!-- 右の読書レンズ。 -->
    <path
        android:pathData="M53,56 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0"
        android:fillColor="#FF03091A"
        android:strokeColor="#4D3DFF" android:strokeWidth="1.1" />
    <path
        android:pathData="M56,56 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0"
        android:strokeColor="#00C2FF" android:strokeWidth="2.2" />
    <path
        android:pathData="M59.6,56 a4.4,4.4 0 1,0 8.8,0 a4.4,4.4 0 1,0 -8.8,0"
        android:strokeColor="#00C2FF" android:strokeWidth="0.8" android:strokeAlpha="0.6" />
    <path android:pathData="M61.3,56 a2.7,2.7 0 1,0 5.4,0 a2.7,2.7 0 1,0 -5.4,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="64" android:centerY="56" android:gradientRadius="2.7">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="0.3" android:color="#FF8ADCFF" />
                <item android:offset="0.65" android:color="#FF00C2FF" />
                <item android:offset="1" android:color="#590079B8" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M60.85,53.8 a0.95,0.95 0 1,0 1.9,0 a0.95,0.95 0 1,0 -1.9,0"
        android:fillColor="#FFFFFFFF" />

    <!-- 嘴。唯一の暖色差し色（AppGradient第3色のCoralと呼応）。 -->
    <path
        android:pathData="M50,67 L58,67 L54,76 Z"
        android:fillColor="#FFFF6B8A" />
</vector>
